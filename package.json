{
	"name": "vue-form-generator",
	"version": "3.1.8",
	"description": "A schema-based form generator component for Vue.js",
	"homepage": "https://github.com/vue-generators/vue-form-generator/",
	"main": "dist/vfg.umd.min.js",
	"scripts": {
		"inspect": "vue-cli-service inspect",
		"serve": "vue-cli-service serve",
		"forcebuild": "vue-cli-service build --target lib --name vfg src/index.js",
		"prebuild": "npm run test:unit",
		"build": "vue-cli-service build --no-clean --target lib --name vfg src/index.js --report",
		"lint": "vue-cli-service lint",
		"lint:fix": "vue-cli-service lint --fix --no-cache",
		"test:unit": "nyc vue-cli-service test:unit --include ./tests/unit/setup.js",
		"coverall": "cat ./tests/unit/coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js",
		"changelog": "conventional-changelog -i CHANGELOG.md -s",
		"changelog:full": "conventional-changelog -i CHANGELOG.md -s -r 0",
		"docs": "cd docs && gitbook serve",
		"version": "bumped release"
	},
	"keywords": [
		"vue",
		"vuejs",
		"form",
		"generator",
		"schema",
		"json"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/vue-generators/vue-form-generator.git"
	},
	"files": [
		"dist/vfg.common.js",
		"dist/vfg.css",
		"dist/vfg.umd.js",
		"dist/vfg.umd.min.js",
		"src"
	],
	"author": "Icebob",
	"maintainers": [
		{
			"name": "David Higgins",
			"email": "higginsd@zoulcreations.com",
			"web": "http://www.fragmentedcode.com"
		},
		{
			"name": "Lionel Bijaoui",
			"email": "lionel.bijaoui@gmail.com"
		}
	],
	"license": "MIT",
	"dependencies": {
		"@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
		"@babel/plugin-proposal-optional-chaining": "^7.18.9",
		"@babel/runtime-corejs3": "^7.27.1",
		"core-js": "^3.36.0"
	},
	"devDependencies": {
		"@babel/core": "^7.18.9",
		"@babel/eslint-parser": "^7.27.1",
		"@babel/plugin-transform-runtime": "^7.27.1",
		"@babel/runtime": "^7.27.1",
		"@vue/cli-plugin-babel": "^5.0.8",
		"@vue/cli-plugin-eslint": "^5.0.8",
		"@vue/cli-plugin-unit-mocha": "^5.0.9",
		"@vue/cli-service": "^5.0.8",
		"@vue/eslint-config-prettier": "^10.1.0",
		"@vue/test-utils": "1.3.6",
		"babel-plugin-istanbul": "5.1.0",
		"babel-plugin-lodash": "3.3.4",
		"babel-runtime": "^6.26.0",
		"bumped": "^0.14.2",
		"chai": "4.2.0",
		"cleave.js": "1.4.4",
		"conventional-changelog-cli": "^2.2.2",
		"coveralls": "3.0.2",
		"css-loader": "^6.9.1",
		"css-minimizer-webpack-plugin": "^6.0.0",
		"eonasdan-bootstrap-datetimepicker": "^4.15.35",
		"eslint-plugin-vue": "^9.33.0",
		"fakerator": "0.3.0",
		"fecha": "2.3.3",
		"html-webpack-plugin": "^4.5.0",
		"ion-rangeslider": "2.2.0",
		"jquery": "^3.7.1",
		"lodash-webpack-plugin": "^0.11.6",
		"nouislider": "11.1.0",
		"nyc": "^15.1.0",
		"pikaday": "1.8.0",
		"prettier": "^3.4.2",
		"sass": "^1.87.0",
		"sass-loader": "^14.2.1",
		"sinon": "7.0.0",
		"vue": "^2.7.16",
		"vue-highlightjs": "1.3.3",
		"vue-loader": "^17.4.2",
		"vue-markdown": "^2.1.3",
		"vue-multiselect": "^2.1.6",
		"vue-template-compiler": "^2.7.16",
		"webpack": "^5.90.3",
		"webpack-cli": "^5.1.4"
	},
	"eslintConfig": {
		"root": true,
		"env": {
			"browser": true,
			"node": true
		},
		"extends": [
			"eslint:recommended",
			"plugin:vue/strongly-recommended",
			"plugin:prettier/recommended"
		],
		"rules": {
			"semi": [
				2,
				"always"
			],
			"no-var": [
				2
			],
			"no-console": [
				0
			],
			"no-unused-vars": [
				1
			],
			"no-throw-literal": 0,
			"eqeqeq": [
				2,
				"smart"
			],
			"vue/name-property-casing": [
				0,
				"kebab-case"
			],
			"vue/first-attribute-linebreak": [
				"error",
				{
					"singleline": "ignore",
					"multiline": "below"
				}
			],
			"vue/html-indent": [
				2,
				"tab",
				{
					"attribute": 1,
					"closeBracket": 0,
					"alignAttributesVertically": true,
					"ignores": []
				}
			]
		},
		"parserOptions": {
			"parser": "@babel/eslint-parser"
		}
	},
	"postcss": {
		"plugins": {
			"autoprefixer": {}
		}
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not ie <= 8"
	],
	"nyc": {
		"check-coverage": false,
		"per-file": true,
		"include": [
			"src/**/*.{js,vue}"
		],
		"exclude": [
			"src/*.js"
		],
		"extension": [
			".js"
		],
		"reporter": [
			"lcov",
			"text",
			"text-summary"
		],
		"report-dir": "./tests/unit/coverage",
		"temp-dir": "./tests/unit/coverage/.nyc_output",
		"cache": true,
		"all": true
	},
	"publishConfig": {
		"access": "public"
	}
}
